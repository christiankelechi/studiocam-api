# StudioCam AI FastAPI Backend Environment Variables
# USER RULE: The FastAPI URL is https://cyberswitchapp-services.duckdns.org/ and is named fastApiUrl in config network API routes.

# Application Security
SECRET_KEY=studiocam-super-secure-production-jwt-secret-key-2026-v2
DEBUG=false

# Cloud AI & GPU Orchestration (RunPod / ComfyUI)
COMFYUI_URL=http://localhost:8188
RUNPOD_GPU_URL=
MOCK_GPU_PROCESSING=true

# Payment Gateways (Paystack & Stripe)
PAYSTACK_SECRET_KEY=sk_test_paystack_studiocam_sample
STRIPE_SECRET_KEY=sk_test_stripe_studiocam_sample

